<Window x:Class="WpfAppDen_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppDen_1"
        mc:Ignorable="d"
        Title="Рассчет затрат" Height="480" Width="800">
    <Grid>
        <Label x:Name="label1" Content="1. Начисление на заработную плату" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="textBox_timeRaz" HorizontalAlignment="Left" Margin="210,42,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label" Content="Время разработки продукта:" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label2" Content="Оклад разработчика:" HorizontalAlignment="Left" Margin="10,66,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_OkladRaz" HorizontalAlignment="Left" Margin="210,71,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label3" Content="2. Затраты с использованием оргтехники" HorizontalAlignment="Left" Margin="10,97,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="label4" Content="Машинное время работы:" HorizontalAlignment="Left" Margin="10,123,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_MashinTime" HorizontalAlignment="Left" Margin="210,128,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label5" Content="3. Затраты на электроэнергию" HorizontalAlignment="Left" Margin="10,154,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="label6" Content="Машинное время работы:" HorizontalAlignment="Left" Margin="10,185,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_MashiTimeEl" HorizontalAlignment="Left" Margin="210,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label7" Content="Тариф электроэнергии:" HorizontalAlignment="Left" Margin="10,216,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_TarifElectro" HorizontalAlignment="Left" Margin="210,222,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label8" Content="4. Амортизация" HorizontalAlignment="Left" Margin="10,246,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="label9" Content="Первоначальная стоим. ПК" HorizontalAlignment="Left" Margin="10,277,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_PervonaStoim" HorizontalAlignment="Left" Margin="210,281,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <ListBox Name="listboxRes" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="387,45,101,233"/>
        <Label x:Name="label10" Content="5. Результаты выполненных расчетов:" HorizontalAlignment="Left" Margin="387,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Button x:Name="button_1" Content="Расчет №1" HorizontalAlignment="Left" Margin="14,308,0,0" VerticalAlignment="Top" Height="29" Width="90" Click="button_1_Click"/>
        <Button x:Name="button_2" Content="Расчет №2" HorizontalAlignment="Left" Margin="119,311,0,0" VerticalAlignment="Top" Height="26" Width="90" Click="button_2_Click"/>
        <Button x:Name="button_3" Content="Расчет №3" HorizontalAlignment="Left" Margin="15,342,0,0" VerticalAlignment="Top" Height="29" Width="90" Click="button_3_Click"/>
        <Button x:Name="button_4" Content="Расчет №4" HorizontalAlignment="Left" Margin="119,342,0,0" VerticalAlignment="Top" Height="29" Width="89" Click="button_4_Click"/>
        <Button x:Name="button_5" Content="Итоговый расчет" HorizontalAlignment="Left" Margin="387,233,0,0" VerticalAlignment="Top" Height="29" Width="110" Click="button_5_Click"/>
    </Grid>
</Window>
